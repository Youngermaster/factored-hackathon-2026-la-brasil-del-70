# Development image for the compose `web` profile: the Vite dev server over a bind mount of apps/web.
# The production image (a static build served by Caddy) is built in phase 16.
FROM node:24.21.0-alpine3.24

ENV COREPACK_HOME=/opt/corepack \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    npm_config_package_import_method=copy

# pnpm comes from corepack at the version pinned in package.json. The node_modules and store mount points are
# created here, owned by the non-root `node` user, so the named volumes mounted over them inherit the ownership.
RUN corepack enable pnpm \
    && corepack install -g pnpm@10.33.0 \
    && mkdir -p /workspace/apps/web/node_modules /home/node/.local/share/pnpm/store \
    && chown -R node:node /opt/corepack /workspace /home/node/.local

USER node
WORKDIR /workspace/apps/web

EXPOSE 5173

CMD ["sh", "-c", "pnpm install --frozen-lockfile && exec pnpm run dev --host 0.0.0.0"]
