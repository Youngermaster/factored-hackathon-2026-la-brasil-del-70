{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank-agent.local/contracts/schemas/handoff.v1.json",
  "x-schema-version": "1.1.0",
  "$defs": {
    "ActionKind": {
      "enum": [
        "create_dispute_case",
        "block_card",
        "submit_credit_application"
      ],
      "title": "ActionKind",
      "type": "string"
    },
    "ActionStatus": {
      "enum": [
        "executed",
        "failed",
        "unknown"
      ],
      "title": "ActionStatus",
      "type": "string"
    },
    "ActionTaken": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionKind"
        },
        "target": {
          "$ref": "#/$defs/SourceRef"
        },
        "confirmed": {
          "title": "Confirmed",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/ActionStatus"
        },
        "verification": {
          "$ref": "#/$defs/VerificationStatus"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "action",
        "target",
        "confirmed",
        "status",
        "verification",
        "evidence"
      ],
      "title": "ActionTaken",
      "type": "object"
    },
    "AuthLevel": {
      "description": "How strongly the session's subject is authenticated, from weakest to strongest.",
      "enum": [
        "none",
        "identified",
        "otp_verified",
        "step_up"
      ],
      "title": "AuthLevel",
      "type": "string"
    },
    "CardAction": {
      "enum": [
        "block",
        "unblock_request",
        "replacement_request"
      ],
      "title": "CardAction",
      "type": "string"
    },
    "CardRequest": {
      "additionalProperties": false,
      "description": "The card request a handoff carries: what the customer asked for, and for which card.",
      "properties": {
        "action": {
          "$ref": "#/$defs/CardAction"
        },
        "product_ref": {
          "$ref": "#/$defs/SourceRef"
        }
      },
      "required": [
        "action",
        "product_ref"
      ],
      "title": "CardRequest",
      "type": "object"
    },
    "ClauseRef": {
      "pattern": "^(SCOPE|AUTH|PRV|DSP|CRD|ESC|INF|ACC|CRE|ELG)-(MX|CO|AR|ALL)-[0-9]+(\\.[0-9]+)*@[1-9][0-9]*$",
      "title": "ClauseRef",
      "type": "string"
    },
    "Country": {
      "enum": [
        "MX",
        "CO",
        "AR"
      ],
      "title": "Country",
      "type": "string"
    },
    "CreditReview": {
      "additionalProperties": false,
      "description": "The credit part of a handoff: what was assessed, why a human is needed, and the internal estimate.",
      "properties": {
        "product_code": {
          "pattern": "^[A-Z][A-Z0-9_-]{2,31}$",
          "title": "Product Code",
          "type": "string"
        },
        "application_ref": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Application Ref"
        },
        "eligibility_outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/EligibilityOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rule_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Z]+\\.[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "review_reasons": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReviewReason"
          },
          "title": "Review Reasons",
          "type": "array"
        },
        "missing_facts": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "title": "Missing Facts",
          "type": "array"
        },
        "risk": {
          "anyOf": [
            {
              "$ref": "#/$defs/CreditReviewRisk"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "x-internal": true
        }
      },
      "required": [
        "product_code",
        "application_ref",
        "eligibility_outcome",
        "rule_ids",
        "reason_codes",
        "review_reasons",
        "missing_facts",
        "risk"
      ],
      "title": "CreditReview",
      "type": "object"
    },
    "CreditReviewRisk": {
      "additionalProperties": false,
      "description": "The estimate a human reviewer sees in a handoff. Agents see it; customers never do.",
      "properties": {
        "band": {
          "$ref": "#/$defs/RiskBand",
          "x-internal": true
        },
        "interval_low": {
          "ge": 0,
          "le": 1,
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Interval Low",
          "type": "string",
          "x-internal": true
        },
        "interval_high": {
          "ge": 0,
          "le": 1,
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Interval High",
          "type": "string",
          "x-internal": true
        },
        "model": {
          "$ref": "#/$defs/ModelRef"
        },
        "label_definition": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Label Definition",
          "type": "string"
        }
      },
      "required": [
        "band",
        "interval_low",
        "interval_high",
        "model",
        "label_definition"
      ],
      "title": "CreditReviewRisk",
      "type": "object"
    },
    "EligibilityOutcome": {
      "description": "There is no approved outcome by design: the synthetic service gives an indication, never a decision.",
      "enum": [
        "indicatively_eligible",
        "not_eligible",
        "review_required",
        "insufficient_data"
      ],
      "title": "EligibilityOutcome",
      "type": "string"
    },
    "EscalationReason": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/EscalationReasonCode"
        },
        "detail": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]*$",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "title": "EscalationReason",
      "type": "object"
    },
    "EscalationReasonCode": {
      "enum": [
        "amount_above_auto_limit",
        "repeat_complainer",
        "legal_or_regulator_mention",
        "distress_signal",
        "human_requested",
        "clarification_exhausted",
        "tool_failure",
        "verification_mismatch",
        "risk_tier_high",
        "sla_breached",
        "unsupported_needs_human",
        "other",
        "card_unblock_requested",
        "card_replacement_requested",
        "credit_review_required",
        "eligibility_contested"
      ],
      "title": "EscalationReasonCode",
      "type": "string"
    },
    "HandoffAuth": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/AuthLevel"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "level",
        "expires_at"
      ],
      "title": "HandoffAuth",
      "type": "object"
    },
    "HandoffRequest": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]*$",
          "title": "Summary",
          "type": "string"
        },
        "intent": {
          "$ref": "#/$defs/Intent"
        }
      },
      "required": [
        "summary",
        "intent"
      ],
      "title": "HandoffRequest",
      "type": "object"
    },
    "Intent": {
      "description": "What the customer wants. Each intent is owned by exactly one workflow or is cross-workflow.\n\n``domain.workflow_catalog.WORKFLOW_CATALOG`` assigns the owners; ``CROSS_WORKFLOW_INTENTS`` lists the rest.",
      "enum": [
        "dispute_new",
        "dispute_status",
        "card_block",
        "informational",
        "unsupported",
        "human_request",
        "greeting_or_other",
        "balance_inquiry",
        "payment_status",
        "statement_request",
        "card_status",
        "card_unblock_request",
        "card_replacement_request",
        "credit_product_info",
        "credit_eligibility",
        "credit_application",
        "credit_application_status"
      ],
      "title": "Intent",
      "type": "string"
    },
    "Language": {
      "enum": [
        "es",
        "pt",
        "en"
      ],
      "title": "Language",
      "type": "string"
    },
    "ModelRef": {
      "pattern": "^(router|resolver|retriever|language_detector|llm|risk_estimator):[a-z][a-z0-9_]{0,63}@[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "ModelRef",
      "type": "string"
    },
    "Priority": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Priority",
      "type": "string"
    },
    "ReviewReason": {
      "enum": [
        "missing_income",
        "missing_credit_score",
        "borderline_risk_interval",
        "risk_estimate_unavailable",
        "days_past_due_present",
        "amount_above_review_threshold",
        "customer_contests_result",
        "product_requires_human_assessment"
      ],
      "title": "ReviewReason",
      "type": "string"
    },
    "RiskBand": {
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ],
      "title": "RiskBand",
      "type": "string"
    },
    "Sentiment": {
      "enum": [
        "positive",
        "neutral",
        "negative",
        "very_negative",
        "unknown"
      ],
      "title": "Sentiment",
      "type": "string"
    },
    "SourceRef": {
      "pattern": "^(customers|products|transactions|dispute_cases|historical_complaints|conversations|turns|execution_records|handoffs|audit_events|policy_clauses|credit_applications|credit_products|eligibility_assessments):[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}$",
      "title": "SourceRef",
      "type": "string"
    },
    "VerificationStatus": {
      "enum": [
        "verified",
        "not_verified",
        "mismatch"
      ],
      "title": "VerificationStatus",
      "type": "string"
    },
    "VerifiedFact": {
      "additionalProperties": false,
      "description": "A fact the system verified, with the record that proves it (``table:id``).",
      "properties": {
        "fact": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1F\\x7F]*$",
          "title": "Fact",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        }
      },
      "required": [
        "fact",
        "source"
      ],
      "title": "VerifiedFact",
      "type": "object"
    },
    "WorkflowRef": {
      "additionalProperties": false,
      "description": "Which workflow definition, and which version of it, handled a turn.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "WorkflowRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.1.0",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "handoff_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Handoff Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "conversation_ref": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Conversation Ref",
      "type": "string"
    },
    "case_ref": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case Ref"
    },
    "state_at_escalation": {
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
      "title": "State At Escalation",
      "type": "string"
    },
    "language": {
      "$ref": "#/$defs/Language"
    },
    "jurisdiction": {
      "$ref": "#/$defs/Country"
    },
    "customer_ref": {
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Customer Ref",
      "type": "string"
    },
    "auth": {
      "$ref": "#/$defs/HandoffAuth"
    },
    "request": {
      "$ref": "#/$defs/HandoffRequest"
    },
    "verified_facts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/VerifiedFact"
      },
      "maxItems": 20,
      "title": "Verified Facts",
      "type": "array"
    },
    "actions_taken": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ActionTaken"
      },
      "maxItems": 10,
      "title": "Actions Taken",
      "type": "array"
    },
    "policy_basis": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ClauseRef"
      },
      "title": "Policy Basis",
      "type": "array"
    },
    "escalation_reason": {
      "$ref": "#/$defs/EscalationReason"
    },
    "open_questions": {
      "default": [],
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "pattern": "^[^\\x00-\\x1F\\x7F]*$",
        "type": "string"
      },
      "maxItems": 10,
      "title": "Open Questions",
      "type": "array"
    },
    "customer_sentiment": {
      "$ref": "#/$defs/Sentiment",
      "default": "unknown"
    },
    "priority": {
      "$ref": "#/$defs/Priority"
    },
    "sla_due": {
      "format": "date-time",
      "title": "Sla Due",
      "type": "string"
    },
    "workflow": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkflowRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "x-added-in": "1.1.0"
    },
    "credit_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/CreditReview"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "x-added-in": "1.1.0"
    },
    "card_request": {
      "anyOf": [
        {
          "$ref": "#/$defs/CardRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "x-added-in": "1.1.0"
    }
  },
  "required": [
    "schema_version",
    "handoff_id",
    "created_at",
    "conversation_ref",
    "case_ref",
    "state_at_escalation",
    "language",
    "jurisdiction",
    "customer_ref",
    "auth",
    "request",
    "verified_facts",
    "actions_taken",
    "policy_basis",
    "escalation_reason",
    "open_questions",
    "customer_sentiment",
    "priority",
    "sla_due"
  ],
  "title": "Handoff",
  "type": "object"
}
