{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank-agent.local/contracts/schemas/execution_record.v1.json",
  "x-schema-version": "1.2.0",
  "$defs": {
    "ActionKind": {
      "enum": [
        "create_dispute_case",
        "block_card",
        "submit_credit_application"
      ],
      "title": "ActionKind",
      "type": "string"
    },
    "AuthLevel": {
      "description": "How strongly the session's subject is authenticated, from weakest to strongest.",
      "enum": [
        "none",
        "identified",
        "otp_verified",
        "step_up"
      ],
      "title": "AuthLevel",
      "type": "string"
    },
    "Channel": {
      "description": "The service channel a conversation runs on (not the channel of a transaction).",
      "enum": [
        "web_chat",
        "agent_console",
        "evaluation_harness"
      ],
      "title": "Channel",
      "type": "string"
    },
    "ClauseRef": {
      "pattern": "^(SCOPE|AUTH|PRV|DSP|CRD|ESC|INF|ACC|CRE|ELG)-(MX|CO|AR|ALL)-[0-9]+(\\.[0-9]+)*@[1-9][0-9]*$",
      "title": "ClauseRef",
      "type": "string"
    },
    "Currency": {
      "enum": [
        "MXN",
        "COP",
        "ARS",
        "USD"
      ],
      "title": "Currency",
      "type": "string"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "Version 1 of the decision contract (``contracts/schemas/decision.v1.json``).",
      "properties": {
        "schema_version": {
          "default": "1.2.0",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "title": "State",
          "type": "string"
        },
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActionKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/DecisionKind"
        },
        "rule_results": {
          "items": {
            "$ref": "#/$defs/RuleResult"
          },
          "title": "Rule Results",
          "type": "array"
        },
        "decisive_rule_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Z]+\\.[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Decisive Rule Ids",
          "type": "array"
        },
        "clause_refs": {
          "items": {
            "$ref": "#/$defs/ClauseRef"
          },
          "title": "Clause Refs",
          "type": "array"
        },
        "policy_pack_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Policy Pack Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "state",
        "action",
        "kind",
        "rule_results",
        "decisive_rule_ids",
        "clause_refs",
        "policy_pack_version"
      ],
      "title": "Decision",
      "type": "object"
    },
    "DecisionKind": {
      "enum": [
        "allow",
        "deny",
        "require_confirmation",
        "require_step_up",
        "clarify",
        "escalate",
        "abstain",
        "refuse"
      ],
      "title": "DecisionKind",
      "type": "string"
    },
    "EligibilityAssessmentRecord": {
      "additionalProperties": false,
      "description": "An eligibility assessment as the execution record keeps it: rule ids and versions, not parameters.",
      "properties": {
        "assessment_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Assessment Id",
          "type": "string"
        },
        "service": {
          "$ref": "#/$defs/ServiceRef"
        },
        "product_code": {
          "pattern": "^[A-Z][A-Z0-9_-]{2,31}$",
          "title": "Product Code",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/EligibilityOutcome"
        },
        "rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RuleVersion"
          },
          "title": "Rules",
          "type": "array"
        },
        "review_reasons": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReviewReason"
          },
          "title": "Review Reasons",
          "type": "array"
        },
        "missing_facts": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "title": "Missing Facts",
          "type": "array"
        },
        "policy_pack_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Policy Pack Version",
          "type": "string"
        }
      },
      "required": [
        "assessment_id",
        "service",
        "product_code",
        "outcome",
        "rules",
        "review_reasons",
        "missing_facts",
        "policy_pack_version"
      ],
      "title": "EligibilityAssessmentRecord",
      "type": "object"
    },
    "EligibilityOutcome": {
      "description": "There is no approved outcome by design: the synthetic service gives an indication, never a decision.",
      "enum": [
        "indicatively_eligible",
        "not_eligible",
        "review_required",
        "insufficient_data"
      ],
      "title": "EligibilityOutcome",
      "type": "string"
    },
    "GroundingReport": {
      "additionalProperties": false,
      "properties": {
        "llm_phrasing_used": {
          "default": false,
          "title": "Llm Phrasing Used",
          "type": "boolean"
        },
        "template_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Id"
        },
        "violations": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "title": "Violations",
          "type": "array"
        }
      },
      "required": [
        "llm_phrasing_used",
        "template_id",
        "violations"
      ],
      "title": "GroundingReport",
      "type": "object"
    },
    "Intent": {
      "description": "What the customer wants. Each intent is owned by exactly one workflow or is cross-workflow.\n\n``domain.workflow_catalog.WORKFLOW_CATALOG`` assigns the owners; ``CROSS_WORKFLOW_INTENTS`` lists the rest.",
      "enum": [
        "dispute_new",
        "dispute_status",
        "card_block",
        "informational",
        "unsupported",
        "human_request",
        "greeting_or_other",
        "balance_inquiry",
        "payment_status",
        "statement_request",
        "card_status",
        "card_unblock_request",
        "card_replacement_request",
        "credit_product_info",
        "credit_eligibility",
        "credit_application",
        "credit_application_status"
      ],
      "title": "Intent",
      "type": "string"
    },
    "IntentPrediction": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "$ref": "#/$defs/Intent"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "candidates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/IntentScore"
          },
          "maxItems": 7,
          "title": "Candidates",
          "type": "array"
        },
        "below_threshold": {
          "title": "Below Threshold",
          "type": "boolean"
        },
        "model": {
          "$ref": "#/$defs/ModelRef"
        }
      },
      "required": [
        "intent",
        "confidence",
        "candidates",
        "below_threshold",
        "model"
      ],
      "title": "IntentPrediction",
      "type": "object"
    },
    "IntentScore": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "$ref": "#/$defs/Intent"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "intent",
        "score"
      ],
      "title": "IntentScore",
      "type": "object"
    },
    "Language": {
      "enum": [
        "es",
        "pt",
        "en"
      ],
      "title": "Language",
      "type": "string"
    },
    "LanguageDetection": {
      "additionalProperties": false,
      "description": "``language`` is ``None`` when the detector is uncertain; the engine then asks the customer.",
      "properties": {
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/Language"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "candidates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LanguageScore"
          },
          "title": "Candidates",
          "type": "array"
        },
        "is_mixed": {
          "default": false,
          "title": "Is Mixed",
          "type": "boolean"
        },
        "detector": {
          "$ref": "#/$defs/ModelRef"
        }
      },
      "required": [
        "language",
        "confidence",
        "candidates",
        "is_mixed",
        "detector"
      ],
      "title": "LanguageDetection",
      "type": "object"
    },
    "LanguageScore": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "$ref": "#/$defs/Language"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "language",
        "score"
      ],
      "title": "LanguageScore",
      "type": "object"
    },
    "LatencyBreakdown": {
      "additionalProperties": false,
      "properties": {
        "total_ms": {
          "minimum": 0,
          "title": "Total Ms",
          "type": "integer"
        },
        "stages": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "title": "Stages",
          "type": "object"
        }
      },
      "required": [
        "total_ms",
        "stages"
      ],
      "title": "LatencyBreakdown",
      "type": "object"
    },
    "LlmCallRecord": {
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "$ref": "#/$defs/PromptRef"
        },
        "model_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Model Id",
          "type": "string"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "ge": 0,
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Cost Usd",
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/LlmCallStatus"
        },
        "error_code": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        }
      },
      "required": [
        "prompt",
        "model_id",
        "input_tokens",
        "output_tokens",
        "cost_usd",
        "latency_ms",
        "status",
        "error_code"
      ],
      "title": "LlmCallRecord",
      "type": "object"
    },
    "LlmCallStatus": {
      "enum": [
        "ok",
        "repaired",
        "failed",
        "fallback"
      ],
      "title": "LlmCallStatus",
      "type": "string"
    },
    "ModelRef": {
      "pattern": "^(router|resolver|retriever|language_detector|llm|risk_estimator):[a-z][a-z0-9_]{0,63}@[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "ModelRef",
      "type": "string"
    },
    "Money": {
      "additionalProperties": false,
      "description": "An amount in one currency. JSON form: ``{\"amount\": \"12.50\", \"currency\": \"MXN\"}``.",
      "properties": {
        "amount": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "resolved",
        "clarified",
        "abstained",
        "escalated",
        "refused",
        "in_progress"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "PromptRef": {
      "pattern": "^[a-z][a-z0-9_]{0,63}@[1-9][0-9]*$",
      "title": "PromptRef",
      "type": "string"
    },
    "RetrievalDecisionCode": {
      "enum": [
        "answer",
        "abstain"
      ],
      "title": "RetrievalDecisionCode",
      "type": "string"
    },
    "RetrievalRecord": {
      "additionalProperties": false,
      "description": "What open retrieval did for an informational turn: which retriever, against which threshold, with what.",
      "properties": {
        "retriever": {
          "$ref": "#/$defs/ModelRef"
        },
        "decision": {
          "$ref": "#/$defs/RetrievalDecisionCode"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "top_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top Score"
        },
        "citations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ClauseRef"
          },
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "retriever",
        "decision",
        "threshold",
        "top_score",
        "citations"
      ],
      "title": "RetrievalRecord",
      "type": "object"
    },
    "ReviewReason": {
      "enum": [
        "missing_income",
        "missing_credit_score",
        "borderline_risk_interval",
        "risk_estimate_unavailable",
        "days_past_due_present",
        "amount_above_review_threshold",
        "customer_contests_result",
        "product_requires_human_assessment"
      ],
      "title": "ReviewReason",
      "type": "string"
    },
    "RiskBand": {
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ],
      "title": "RiskBand",
      "type": "string"
    },
    "RiskEstimateRecord": {
      "additionalProperties": false,
      "description": "A risk estimate as the execution record keeps it (glass box, phase 13). Internal.",
      "properties": {
        "model": {
          "$ref": "#/$defs/ModelRef"
        },
        "estimate_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Estimate Id",
          "type": "string"
        },
        "probability": {
          "ge": 0,
          "le": 1,
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Probability",
          "type": "string",
          "x-internal": true
        },
        "interval_low": {
          "ge": 0,
          "le": 1,
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Interval Low",
          "type": "string",
          "x-internal": true
        },
        "interval_high": {
          "ge": 0,
          "le": 1,
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Interval High",
          "type": "string",
          "x-internal": true
        },
        "band": {
          "$ref": "#/$defs/RiskBand",
          "x-internal": true
        },
        "flags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UncertaintyFlag"
          },
          "title": "Flags",
          "type": "array"
        },
        "label_definition": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Label Definition",
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        }
      },
      "required": [
        "model",
        "estimate_id",
        "probability",
        "interval_low",
        "interval_high",
        "band",
        "flags",
        "label_definition",
        "latency_ms"
      ],
      "title": "RiskEstimateRecord",
      "type": "object"
    },
    "RiskTier": {
      "enum": [
        "low",
        "elevated",
        "high"
      ],
      "title": "RiskTier",
      "type": "string"
    },
    "RuleResult": {
      "additionalProperties": false,
      "description": "The outcome of one rule. A failed rule names the effect it asks the evaluator to apply.",
      "properties": {
        "rule_id": {
          "pattern": "^[A-Z]+\\.[a-z][a-z0-9_]*$",
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "exclusiveMinimum": 0,
          "title": "Rule Version",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason_code": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Reason Code",
          "type": "string"
        },
        "params": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/Money"
                },
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            }
          },
          "title": "Params",
          "type": "object"
        },
        "clause_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ClauseRef"
          },
          "title": "Clause Refs",
          "type": "array"
        },
        "missing_facts": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "title": "Missing Facts",
          "type": "array"
        }
      },
      "required": [
        "rule_id",
        "rule_version",
        "passed",
        "effect",
        "reason_code",
        "params",
        "clause_refs",
        "missing_facts"
      ],
      "title": "RuleResult",
      "type": "object"
    },
    "RuleVersion": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "pattern": "^[A-Z]+\\.[a-z][a-z0-9_]*$",
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "minimum": 1,
          "title": "Rule Version",
          "type": "integer"
        }
      },
      "required": [
        "rule_id",
        "rule_version"
      ],
      "title": "RuleVersion",
      "type": "object"
    },
    "ServiceRef": {
      "pattern": "^eligibility:[a-z][a-z0-9_]{0,63}@[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "ServiceRef",
      "type": "string"
    },
    "SourceRef": {
      "pattern": "^(customers|products|transactions|dispute_cases|historical_complaints|conversations|turns|execution_records|handoffs|audit_events|policy_clauses|credit_applications|credit_products|eligibility_assessments):[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}$",
      "title": "SourceRef",
      "type": "string"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "title": "TokenUsage",
      "type": "object"
    },
    "ToolCallRecord": {
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "exclusiveMinimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "tool": {
          "$ref": "#/$defs/ToolName"
        },
        "arguments": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "title": "Arguments",
          "type": "object"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{16,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "status": {
          "$ref": "#/$defs/ToolCallStatus"
        },
        "error_code": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "attempts": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "result_summary": {
