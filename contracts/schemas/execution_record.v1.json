    "ToolName": {
      "description": "Every banking tool (phase 05).\n\nThree are writes and share their value with an ``ActionKind``: ``create_dispute_case``, ``block_card``, and\n``submit_credit_application``. Every other tool reads. ``get_product_status`` also serves card status, and\n``list_my_cards`` lists the customer's cards so the card workflow can offer a masked choice. The\nrisk estimator and the eligibility service are not tools: the engine calls them, and no model output can\nselect them.",
      "enum": [
        "list_recent_transactions",
        "get_transaction",
        "get_product_status",
        "list_my_cards",
        "list_my_cases",
        "get_case_status",
        "create_dispute_case",
        "block_card",
        "list_my_balances",
        "get_payment_status",
        "get_statement_summary",
        "list_credit_products",
        "get_credit_product",
        "get_my_credit_profile",
        "submit_credit_application",
        "get_credit_application_status"
      ],
      "title": "ToolName",
      "type": "string"
    },
