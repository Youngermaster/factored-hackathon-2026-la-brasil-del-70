{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank-agent.local/contracts/schemas/model_decision.v1.json",
  "x-schema-version": "1.3.0",
  "$defs": {
    "AccountInquirySlotExtraction": {
      "additionalProperties": false,
      "description": "``extract_account_inquiry_slots``: which product, which statement period, which payment.",
      "properties": {
        "product_hint": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProductHint"
            },
            {
              "type": "null"
            }
          ]
        },
        "statement_period_expression": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Statement Period Expression"
        },
        "payment": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaymentDescriptor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "product_hint",
        "statement_period_expression",
        "payment"
      ],
      "title": "AccountInquirySlotExtraction",
      "type": "object"
    },
    "Currency": {
      "enum": [
        "MXN",
        "COP",
        "ARS",
        "USD"
      ],
      "title": "Currency",
      "type": "string"
    },
    "DecisionIntent": {
      "description": "The label set of ``ModelDecision``: every ``Intent`` plus the two assistant profile requests of ADR 0025.\nA test keeps it in step with ``Intent``. There is no ``clarify`` or ``abstain`` label: the engine clarifies\nbelow the router threshold and abstains on ``unsupported``, so the model never picks a policy outcome.",
      "enum": [
        "dispute_new",
        "dispute_status",
        "card_block",
        "informational",
        "unsupported",
        "human_request",
        "greeting_or_other",
        "balance_inquiry",
        "payment_status",
        "statement_request",
        "card_status",
        "card_unblock_request",
        "card_replacement_request",
        "credit_product_info",
        "credit_eligibility",
        "credit_application",
        "credit_application_status",
        "change_assistant_name",
        "change_assistant_avatar"
      ],
      "title": "DecisionIntent",
      "type": "string"
    },
    "PaymentDescriptor": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "ge": 0
            },
            {
              "type": "null"
            }
          ],
          "title": "Amount"
        },
        "currency_hint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Currency"
            },
            {
              "type": "null"
            }
          ]
        },
        "date_expression": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Date Expression"
        },
        "payee_text": {
          "anyOf": [
            {
              "maxLength": 150,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Payee Text"
        }
      },
      "required": [
        "amount",
        "currency_hint",
        "date_expression",
        "payee_text"
      ],
      "title": "PaymentDescriptor",
      "type": "object"
    },
    "ProductHint": {
      "additionalProperties": false,
      "properties": {
        "product_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProductType"
            },
            {
              "type": "null"
            }
          ]
        },
        "last4": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last4"
        }
      },
      "required": [
        "product_type",
        "last4"
      ],
      "title": "ProductHint",
      "type": "object"
    },
    "ProductType": {
      "enum": [
        "checking_account",
        "savings_account",
        "credit_card",
        "debit_card",
        "personal_loan",
        "mortgage",
        "investment",
        "other"
      ],
      "title": "ProductType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "``decide_intent``: the published, versioned model output of the Tuesday MVP (``model_decision.v1.json``).\n\nIt names what the customer wants and the slots the customer stated, nothing else. There is no customer,\nconversation, session, product id, or tool field: the server takes those from the verified session, so no\nmodel output can choose whose data is read or which conversation is written (ADR 0025). ``account`` is set\nonly for an account inquiry and ``assistant_name`` only for a rename; every other combination is invalid, so\nthe gateway repairs once and then falls back to the rule router.",
  "properties": {
    "schema_version": {
      "default": "1.3.0",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "intent": {
      "$ref": "#/$defs/DecisionIntent"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "account": {
      "anyOf": [
        {
          "$ref": "#/$defs/AccountInquirySlotExtraction"
        },
        {
          "type": "null"
        }
      ]
    },
    "assistant_name": {
      "anyOf": [
        {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[A-Za-zÀ-ÖØ-öø-ÿ]+(?:[ '-][A-Za-zÀ-ÖØ-öø-ÿ]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Assistant Name"
    }
  },
  "required": [
    "intent",
    "confidence",
    "account",
    "assistant_name"
  ],
  "title": "ModelDecision",
  "type": "object"
}
