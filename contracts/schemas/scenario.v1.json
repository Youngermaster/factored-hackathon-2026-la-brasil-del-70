{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank-agent.local/contracts/schemas/scenario.v1.json",
  "x-schema-version": "1.4.0",
  "$defs": {
    "ApplicationStatus": {
      "enum": [
        "submitted",
        "under_human_review",
        "withdrawn",
        "closed"
      ],
      "title": "ApplicationStatus",
      "type": "string"
    },
    "CaseCount": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "case_count",
          "default": "case_count",
          "title": "Kind",
          "type": "string"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "count"
      ],
      "title": "CaseCount",
      "type": "object"
    },
    "CaseExists": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "case_exists",
          "default": "case_exists",
          "title": "Kind",
          "type": "string"
        },
        "transaction_ref": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Transaction Ref",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/DisputeReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/DisputeStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "transaction_ref"
      ],
      "title": "CaseExists",
      "type": "object"
    },
    "CreditApplicationCount": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "credit_application_count",
          "default": "credit_application_count",
          "title": "Kind",
          "type": "string"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "count"
      ],
      "title": "CreditApplicationCount",
      "type": "object"
    },
    "CreditApplicationExists": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "credit_application_exists",
          "default": "credit_application_exists",
          "title": "Kind",
          "type": "string"
        },
        "product_code": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_-]{2,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Code"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApplicationStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "CreditApplicationExists",
      "type": "object"
    },
    "CreditProfileOverride": {
      "additionalProperties": false,
      "description": "Sets one credit fact of the persona's profile, or clears it with ``value: null`` (missing data).",
      "properties": {
        "kind": {
          "const": "credit_profile_override",
          "default": "credit_profile_override",
          "title": "Kind",
          "type": "string"
        },
        "fact": {
          "enum": [
            "credit_score",
            "estimated_monthly_income",
            "max_days_past_due"
          ],
          "title": "Fact",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "fact"
      ],
      "title": "CreditProfileOverride",
      "type": "object"
    },
    "Currency": {
      "enum": [
        "MXN",
        "COP",
        "ARS",
        "USD"
      ],
      "title": "Currency",
      "type": "string"
    },
    "DisclosureKind": {
      "enum": [
        "case_reference",
        "sla",
        "clause_citation",
        "other_customer_id",
        "other_customer_name",
        "product_number",
        "internal_flag",
        "fraud_score",
        "phrase",
        "balance",
        "as_of_date",
        "eligibility_reason",
        "review_path",
        "credit_approval_claim",
        "risk_estimate",
        "credit_score",
        "income"
      ],
      "title": "DisclosureKind",
      "type": "string"
    },
    "DisclosureSpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/DisclosureKind"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DisclosureSpec",
      "type": "object"
    },
    "DisputeReason": {
      "enum": [
        "unrecognized",
        "duplicate",
        "wrong_amount",
        "not_received",
        "atm_cash_not_dispensed",
        "subscription_cancelled",
        "other"
      ],
      "title": "DisputeReason",
      "type": "string"
    },
    "DisputeStatus": {
      "enum": [
        "opened",
        "in_review",
        "resolved",
        "rejected",
        "escalated"
      ],
      "title": "DisputeStatus",
      "type": "string"
    },
    "EligibilityOutcome": {
      "description": "There is no approved outcome by design: the synthetic service gives an indication, never a decision.",
      "enum": [
        "indicatively_eligible",
        "not_eligible",
        "review_required",
        "insufficient_data"
      ],
      "title": "EligibilityOutcome",
      "type": "string"
    },
    "EligibilityOutcomeIs": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "eligibility_outcome",
          "default": "eligibility_outcome",
          "title": "Kind",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/EligibilityOutcome"
        }
      },
      "required": [
        "outcome"
      ],
      "title": "EligibilityOutcomeIs",
      "type": "object"
    },
    "EscalationReasonCode": {
      "enum": [
        "amount_above_auto_limit",
        "repeat_complainer",
        "legal_or_regulator_mention",
        "distress_signal",
        "human_requested",
        "clarification_exhausted",
        "tool_failure",
        "verification_mismatch",
        "risk_tier_high",
        "sla_breached",
        "unsupported_needs_human",
        "other",
        "card_unblock_requested",
        "card_replacement_requested",
        "credit_review_required",
        "eligibility_contested"
      ],
      "title": "EscalationReasonCode",
      "type": "string"
    },
    "ExistingCase": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "existing_case",
          "default": "existing_case",
          "title": "Kind",
          "type": "string"
        },
        "transaction_ref": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Transaction Ref",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DisputeStatus"
        },
        "reason": {
          "$ref": "#/$defs/DisputeReason"
        }
      },
      "required": [
        "transaction_ref",
        "status",
        "reason"
      ],
      "title": "ExistingCase",
      "type": "object"
    },
    "ExistingCreditApplication": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "existing_credit_application",
          "default": "existing_credit_application",
          "title": "Kind",
          "type": "string"
        },
        "product_code": {
          "pattern": "^[A-Z][A-Z0-9_-]{2,31}$",
          "title": "Product Code",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ApplicationStatus",
          "default": "submitted"
        }
      },
      "required": [
        "product_code"
      ],
      "title": "ExistingCreditApplication",
      "type": "object"
    },
    "HandoffExists": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "handoff_exists",
          "default": "handoff_exists",
          "title": "Kind",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/EscalationReasonCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "HandoffExists",
      "type": "object"
    },
    "Language": {
      "enum": [
        "es",
        "pt",
        "en"
      ],
      "title": "Language",
      "type": "string"
    },
    "Locale": {
      "enum": [
        "es-MX",
        "es-CO",
        "es-AR",
        "pt-BR",
        "en-US"
      ],
      "title": "Locale",
      "type": "string"
    },
    "MerchantNameOverride": {
      "additionalProperties": false,
      "description": "Replaces a record's merchant name, for example with indirect prompt-injection text.",
      "properties": {
        "kind": {
          "const": "merchant_name_override",
          "default": "merchant_name_override",
          "title": "Kind",
          "type": "string"
        },
        "transaction_ref": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Transaction Ref",
          "type": "string"
        },
        "value": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "transaction_ref",
        "value"
      ],
      "title": "MerchantNameOverride",
      "type": "object"
    },
    "ModelComponent": {
      "enum": [
        "router",
        "resolver",
        "retriever",
        "language_detector",
        "llm",
        "risk_estimator"
      ],
      "title": "ModelComponent",
      "type": "string"
    },
    "ModelUnavailable": {
      "additionalProperties": false,
      "description": "The named component fails for the whole scenario, for example the risk estimator.",
      "properties": {
        "kind": {
          "const": "model_unavailable",
          "default": "model_unavailable",
          "title": "Kind",
          "type": "string"
        },
        "component": {
          "$ref": "#/$defs/ModelComponent"
        }
      },
      "required": [
        "component"
      ],
      "title": "ModelUnavailable",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "description": "An amount in one currency. JSON form: ``{\"amount\": \"12.50\", \"currency\": \"MXN\"}``.",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "NoWrites": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "no_writes",
          "default": "no_writes",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "NoWrites",
      "type": "object"
    },
    "ProductStatus": {
      "enum": [
        "active",
        "blocked",
        "closed",
        "suspended"
      ],
      "title": "ProductStatus",
      "type": "string"
    },
    "ProductStatusIs": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "product_status",
          "default": "product_status",
          "title": "Kind",
          "type": "string"
        },
        "product_ref": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Product Ref",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ProductStatus"
        }
      },
      "required": [
        "product_ref",
        "status"
      ],
      "title": "ProductStatusIs",
      "type": "object"
    },
    "ProductStatusOverride": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "product_status_override",
          "default": "product_status_override",
          "title": "Kind",
          "type": "string"
        },
        "product_ref": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Product Ref",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ProductStatus"
        }
      },
      "required": [
        "product_ref",
        "status"
      ],
      "title": "ProductStatusOverride",
      "type": "object"
    },
    "Provenance": {
      "enum": [
        "derived_from_record",
        "team_generated",
        "translated",
        "llm_paraphrase"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "pending_review",
        "approved",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "ScenarioCategory": {
      "enum": [
        "normal",
        "ambiguous",
        "unsupported",
        "human_required",
        "missing_or_incorrect_data",
        "expired_session",
        "unauthorized_access",
        "prompt_injection",
        "tool_failure"
      ],
      "title": "ScenarioCategory",
      "type": "string"
    },
    "ScenarioMode": {
      "enum": [
        "scripted",
        "simulated"
      ],
      "title": "ScenarioMode",
      "type": "string"
    },
    "ScriptedTurn": {
      "additionalProperties": false,
      "description": "One customer turn: either a message or an action, optionally after the clock moves forward.",
      "properties": {
        "text": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "option_index": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Option Index"
        },
        "advance_clock_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Advance Clock Seconds",
          "type": "integer"
        }
      },
      "title": "ScriptedTurn",
      "type": "object"
    },
    "SessionExpiresBeforeTurn": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "session_expires_before_turn",
          "default": "session_expires_before_turn",
          "title": "Kind",
          "type": "string"
        },
        "turn_index": {
          "exclusiveMinimum": 0,
          "title": "Turn Index",
          "type": "integer"
        }
      },
      "required": [
        "turn_index"
      ],
      "title": "SessionExpiresBeforeTurn",
      "type": "object"
    },
    "Split": {
      "enum": [
        "dev",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "ToolFailureMode": {
      "description": "Failure modes the test-only ``ToolFailureInjector`` (phase 05) and evaluation scenarios use.",
      "enum": [
        "timeout",
        "transient_error",
        "permanent_error",
        "partial_write"
      ],
      "title": "ToolFailureMode",
      "type": "string"
    },
    "ToolFailureStep": {
      "additionalProperties": false,
      "description": "Fail the ``on_call``-th call of ``tool`` (1-based), ``times`` times in a row.",
      "properties": {
        "tool": {
          "$ref": "#/$defs/ToolName"
        },
        "mode": {
          "$ref": "#/$defs/ToolFailureMode"
        },
        "on_call": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "On Call",
          "type": "integer"
        },
        "times": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Times",
          "type": "integer"
        }
      },
      "required": [
        "tool",
        "mode"
      ],
      "title": "ToolFailureStep",
      "type": "object"
    },
    "ToolName": {
      "description": "Every banking tool (phase 05).\n\nThree are writes and share their value with an ``ActionKind``: ``create_dispute_case``, ``block_card``, and\n``submit_credit_application``. Every other tool reads. ``get_product_status`` also serves card status, and\n``list_my_cards`` lists the customer's cards so the card workflow can offer a masked choice, and\n``list_my_credit_applications`` lists their credit application intakes so a status question needs no id. The\nrisk estimator and the eligibility service are not tools: the engine calls them, and no model output can\nselect them.",
      "enum": [
        "list_recent_transactions",
        "get_transaction",
        "get_product_status",
        "list_my_cards",
        "list_my_cases",
        "get_case_status",
        "create_dispute_case",
        "block_card",
        "list_my_balances",
        "get_payment_status",
        "get_statement_summary",
        "list_credit_products",
        "get_credit_product",
        "get_my_credit_profile",
        "submit_credit_application",
        "get_credit_application_status",
        "list_my_credit_applications"
      ],
      "title": "ToolName",
      "type": "string"
    },
    "TurnAction": {
      "enum": [
        "select_option",
        "confirm",
        "decline",
        "complete_step_up"
      ],
      "title": "TurnAction",
      "type": "string"
    },
    "WorkflowId": {
      "description": "The supported workflows (section 1 of CLAUDE.md). ``WorkflowRef.id`` stays a pattern-constrained string in\nevery contract; membership in this registry is checked by the application, not by the schemas.",
      "enum": [
        "account_inquiry",
        "card_support",
        "dispute",
        "credit"
      ],
      "title": "WorkflowId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.4.0",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
      "title": "Id",
      "type": "string"
    },
    "split": {
      "$ref": "#/$defs/Split"
    },
    "language": {
      "$ref": "#/$defs/Language"
    },
    "dialect": {
      "$ref": "#/$defs/Locale"
    },
    "category": {
      "$ref": "#/$defs/ScenarioCategory"
    },
    "tags": {
      "default": [],
      "items": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "persona_ref": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Persona Ref",
      "type": "string"
    },
    "goal": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "known_facts": {
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        }
      },
      "title": "Known Facts",
      "type": "object"
    },
    "hidden_facts": {
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        }
      },
      "title": "Hidden Facts",
      "type": "object"
    },
    "mode": {
      "$ref": "#/$defs/ScenarioMode"
    },
    "turns": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ScriptedTurn"
      },
      "title": "Turns",
      "type": "array"
    },
    "simulator_instructions": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Simulator Instructions"
    },
    "fixtures": {
      "default": [],
      "items": {
        "discriminator": {
          "mapping": {
            "credit_profile_override": "#/$defs/CreditProfileOverride",
            "existing_case": "#/$defs/ExistingCase",
            "existing_credit_application": "#/$defs/ExistingCreditApplication",
            "merchant_name_override": "#/$defs/MerchantNameOverride",
            "model_unavailable": "#/$defs/ModelUnavailable",
            "product_status_override": "#/$defs/ProductStatusOverride",
            "session_expires_before_turn": "#/$defs/SessionExpiresBeforeTurn"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/MerchantNameOverride"
          },
          {
            "$ref": "#/$defs/ProductStatusOverride"
          },
          {
            "$ref": "#/$defs/ExistingCase"
          },
          {
            "$ref": "#/$defs/SessionExpiresBeforeTurn"
          },
          {
            "$ref": "#/$defs/CreditProfileOverride"
          },
          {
            "$ref": "#/$defs/ExistingCreditApplication"
          },
          {
            "$ref": "#/$defs/ModelUnavailable"
          }
        ]
      },
      "title": "Fixtures",
      "type": "array"
    },
    "tool_failure_plan": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolFailureStep"
      },
      "title": "Tool Failure Plan",
      "type": "array"
    },
    "expected_outcome": {
      "enum": [
        "resolved",
        "clarified",
        "abstained",
        "escalated",
        "refused"
      ],
      "title": "Expected Outcome",
      "type": "string"
    },
    "expected_state_assertions": {
      "default": [],
      "items": {
        "discriminator": {
          "mapping": {
            "case_count": "#/$defs/CaseCount",
            "case_exists": "#/$defs/CaseExists",
            "credit_application_count": "#/$defs/CreditApplicationCount",
            "credit_application_exists": "#/$defs/CreditApplicationExists",
            "eligibility_outcome": "#/$defs/EligibilityOutcomeIs",
            "handoff_exists": "#/$defs/HandoffExists",
            "no_writes": "#/$defs/NoWrites",
            "product_status": "#/$defs/ProductStatusIs"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/CaseExists"
          },
          {
            "$ref": "#/$defs/CaseCount"
          },
          {
