# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
.claude/settings.local.json

# Build kit (prompts and organizer PDFs stay private; remove this line to share prompts in git)
kit/
# Personal working notes and ad hoc queries outside the repository conventions
personal/

# Organizer and derived data (never commit)
**/data/*
!data/.gitkeep
# Documentation about the data is not data.
!docs/data/
!docs/data/*.md
# Team-written evaluation inputs (relevance judgments), not organizer data.
!evals/data/
!evals/data/*.jsonl
# The pitch deck's metric registry (team-written numbers with sources), not organizer data.
!slides/data/
!slides/data/*.yml
*.parquet
*.duckdb
*.duckdb.wal

# ML tracking and artifacts
mlruns/
mlruns.db
mlartifacts/
models/artifacts/
*.pkl
*.joblib
*.onnx

# Evaluation outputs (summaries are published explicitly under docs/evaluation)
reports/eval/**/raw/
evals/cassettes/**/*.tmp

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
coverage.json
.hypothesis/
.import_linter_cache/
htmlcov/
dist/
build/
*.egg-info/

# dbt
data_platform/dbt/target/
data_platform/dbt/logs/
data_platform/dbt/dbt_packages/

# Node and web
node_modules/
.pnpm-store/
apps/web/dist/
apps/web/coverage/
apps/web/.vite/
*.tsbuildinfo

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local screenshots of the web app (apps/web/tooling/screenshots.mjs)
apps/web/.shots/
