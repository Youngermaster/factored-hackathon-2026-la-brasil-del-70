{
  "uid": "bank-agent-executive",
  "title": "Bank agent: executive analytics",
  "description": "Live operational and product analytics from privacy-safe OpenTelemetry metrics. This dashboard does not contain offline evaluation results or customer data.",
  "tags": [
    "bank-agent",
    "executive",
    "live-telemetry"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "workflow",
        "label": "Workflow",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(bank_turn_outcomes_total, bank_workflow)",
          "refId": "workflow-variable"
        },
        "definition": "label_values(bank_turn_outcomes_total, bank_workflow)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "language",
        "label": "Language",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(bank_turn_outcomes_total, bank_language)",
          "refId": "language-variable"
        },
        "definition": "label_values(bank_turn_outcomes_total, bank_language)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Executive summary",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Turns in selected period",
      "description": "Stored turns matching the workflow and language filters.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(bank_turn_outcomes_total{bank_workflow=~\"$workflow\",bank_language=~\"$language\"}[$__range])) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Resolved turn share",
      "description": "Turns with outcome resolved divided by all turns. This is an operational outcome, not the offline safe automated resolution metric.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(increase(bank_turn_outcomes_total{bank_workflow=~\"$workflow\",bank_language=~\"$language\",bank_outcome=\"resolved\"}[$__range])) / clamp_min(sum(increase(bank_turn_outcomes_total{bank_workflow=~\"$workflow\",bank_language=~\"$language\"}[$__range])), 1)",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Escalated turn share",
      "description": "Turns with outcome escalated divided by all turns for the same filters.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(increase(bank_turn_outcomes_total{bank_workflow=~\"$workflow\",bank_language=~\"$language\",bank_outcome=\"escalated\"}[$__range])) / clamp_min(sum(increase(bank_turn_outcomes_total{bank_workflow=~\"$workflow\",bank_language=~\"$language\"}[$__range])), 1)",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Turn latency p95",
      "description": "95th percentile of stored-turn latency over the selected period and workflow filter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(bank_turn_duration_seconds_bucket{bank_workflow=~\"$workflow\"}[$__range])))",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Safety interventions",
      "description": "Recorded safety interventions in the selected period and workflow filter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(bank_safety_interventions_total{bank_workflow=~\"$workflow\"}[$__range])) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Active sessions",
      "description": "Maximum deployment-wide active session gauge across API workers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(bank_sessions_active) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Demand and outcomes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Turn volume by workflow",
      "description": "Number of stored turns during the selected period, split by workflow and filtered by language.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (bank_workflow) (increase(bank_turn_outcomes_total{bank_workflow=~\"$workflow\",bank_language=~\"$language\"}[$__range])) > 0",
          "legendFormat": "{{bank_workflow}}",
          "instant": true
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Outcome rate over time",
      "description": "Per-second turn rate by workflow and outcome. The time axis reveals changes hidden by period totals.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 8,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal",
              "group": "outcomes"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (bank_workflow, bank_outcome) (rate(bank_turn_outcomes_total{bank_workflow=~\"$workflow\",bank_language=~\"$language\"}[$__rate_interval])) > 0",
          "legendFormat": "{{bank_workflow}} / {{bank_outcome}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "piechart",
      "title": "Language mix",
      "description": "Turn volume by detected language for the selected workflow filter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (bank_language) (increase(bank_turn_outcomes_total{bank_workflow=~\"$workflow\",bank_language=~\"$language\"}[$__range])) > 0",
          "legendFormat": "{{bank_language}}",
          "instant": true
        }
      ]
    },
    {
