    {
      "id": 25,
      "type": "stat",
      "title": "Degradation level",
      "description": "Maximum worker degradation level: 0 normal, 1 fallback provider, 2 template only, 3 baselines, 4 database unavailable.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 3,
        "x": 21,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "max": 4,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "L0 normal",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "L1 fallback model",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
