# Server environment for deploy/compose.prod.yml. Copy it to deploy/.env.production ON THE SERVER, fill it there,
# and keep it mode 600. Never commit the filled file or paste its values anywhere (deploy/README.md, "Secrets").
# Every variable is listed with no value: an empty value means the default in deploy/compose.prod.yml; the ones
# marked "required" have no default and the stack refuses to start without them. `deploy/prod.sh secrets` prints
# fresh random values for the secrets, for you to paste here.

# --- Site and TLS -----------------------------------------------------------------------------------------------
# Required. The public host name, for example demo.example.org (a DNS A record points it at the VM).
SITE_ADDRESS=
# Required. The browser origin, https://<SITE_ADDRESS>; the API's CORS allowlist. https only.
PUBLIC_ORIGIN=
# acme (default: certificates from Let's Encrypt) or internal (Caddy's local CA, for a local test only).
CADDY_TLS=
# The contact address given to the certificate authority (acme mode).
ACME_EMAIL=
# Host ports; default 80 and 443. The local test uses 8080 and 8443.
HTTP_PORT=
HTTPS_PORT=

# --- PostgreSQL (never published; the API connects as the application role) -----------------------------------
POSTGRES_DB=
# Required. The bootstrap superuser, used only for backups and restores inside the container.
POSTGRES_SUPERUSER_PASSWORD=
# The owner role (migrations, the seed, the retention purge); default bank_owner. Never given to the API.
POSTGRES_ADMIN_USER=
# Required. At least 32 characters.
POSTGRES_ADMIN_PASSWORD=
# The application role; default bank_app.
POSTGRES_APP_USER=
# Required. At least 32 characters.
POSTGRES_APP_PASSWORD=

# --- Sessions and CSRF ------------------------------------------------------------------------------------------
# Required. At least 32 characters. Identity lookups derive from it: rotating it means seeding again.
SESSION_SECRET=
# Required. At least 32 characters.
CSRF_SECRET=

# --- Demo mode (docs/security/demo-mode.md) ---------------------------------------------------------------------
# The public judging demo sets all three to true: demo one-time codes on screen, over synthetic data only.
DEMO_MODE=
ALLOW_PUBLIC_DEMO_MODE=
# Build-time switch of the web image (the persona picker); rebuild the web image after changing it.
VITE_DEMO_MODE=

# --- API ----------------------------------------------------------------------------------------------------------
# uvicorn worker processes; default 2 (docs/operations/capacity.md).
API_WORKERS=
LOG_LEVEL=
# Rate limits per minute; defaults 10, 30, 120 per IP and 10, 20, 60 per session. Shared by every worker.
RATE_LIMIT_AUTH_PER_MINUTE=
RATE_LIMIT_WRITE_PER_MINUTE=
RATE_LIMIT_READ_PER_MINUTE=
RATE_LIMIT_SESSION_AUTH_PER_MINUTE=
RATE_LIMIT_SESSION_WRITE_PER_MINUTE=
RATE_LIMIT_SESSION_READ_PER_MINUTE=
# true serves the published evaluation summaries without a session (read only).
EVAL_SUMMARIES_PUBLIC=

# --- Language model (docs/architecture/llm-gateway.md; deploy/README.md, "Choosing the model") --------------------
# fake (default: no model; deterministic paths) or litellm.
LLM_PROVIDER=
# For example openai/gpt-5-mini, anthropic/claude-haiku-4-5-20251001, or ollama/qwen2.5:7b-instruct.
LLM_PRIMARY_MODEL=
LLM_FALLBACK_MODEL=
# Required for a hosted provider. Never needed for the ollama profile.
LLM_API_KEY_PRIMARY=
LLM_API_KEY_FALLBACK=
# Optional base URL; https only, except http://ollama:11434 with LLM_ALLOW_PRIVATE_HTTP_BASE=true.
LLM_API_BASE=
LLM_ALLOW_PRIVATE_HTTP_BASE=
# Spend caps in USD (defaults 5 per day, 0.50 per conversation) and tokens per session lineage (20000).
LLM_DAILY_BUDGET_USD=
LLM_CONVERSATION_BUDGET_USD=
LLM_SESSION_TOKEN_LIMIT=
LLM_TIMEOUT_SECONDS=
WORKFLOW_LLM_UNDERSTANDING=
WORKFLOW_LLM_PHRASING=
WORKFLOW_LLM_HANDOFF_SUMMARY=
# Synthetic eligibility assessments per customer per window (defaults 5 per 60 minutes); past it a person reviews.
WORKFLOW_MAX_ELIGIBILITY_ASSESSMENTS=
WORKFLOW_ELIGIBILITY_ASSESSMENT_WINDOW_MINUTES=

# --- Retention (docs/security/data-retention.md) ------------------------------------------------------------------
# Days; defaults 7, 7, 30. The purge runs every PURGE_EVERY_HOURS (default 24).
RETENTION_CONVERSATION_DAYS=
RETENTION_SESSION_DAYS=
RETENTION_CREDIT_APPLICATION_DAYS=
PURGE_EVERY_HOURS=
# Customers loaded by `deploy/prod.sh seed` besides the personas; default 200.
SEED_CUSTOMERS=

# --- Observability (the obs profile; docs/operations/observability.md) -------------------------------------------
# true exports traces and metrics to the obs profile's collector.
OTEL_ENABLED=
OTEL_TRACES_SAMPLER_ARG=
GRAFANA_ADMIN_USER=
# Required to start the obs profile (deploy/prod.sh checks it). At least 16 characters.
GRAFANA_ADMIN_PASSWORD=
# Loopback ports for the SSH tunnel; defaults 3000 (Grafana) and 16686 (the Jaeger UI, no login).
GRAFANA_PORT=
JAEGER_PORT=

# --- Networking (change only if the default subnet clashes with the VM's network) --------------------------------
EDGE_SUBNET=
WEB_EDGE_ADDRESS=
