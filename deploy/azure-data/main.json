{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "storageName": {
      "type": "string"
    },
    "operatorId": {
      "type": "string"
    },
    "sshPublicKey": {
      "type": "string"
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_B2ms"
    },
    "deployVm": {
      "type": "bool",
      "defaultValue": true
    }
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[parameters('storageName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "project": "la70",
        "event": "factored-hackathon-2026",
        "env": "test",
        "component": "data-pipeline"
      },
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": false
      },
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[concat(parameters('storageName'), '/default/artifacts')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageName'))]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-11-01",
      "name": "nsg-la70-data",
      "location": "[resourceGroup().location]",
      "tags": {
        "project": "la70",
        "event": "factored-hackathon-2026",
        "env": "test",
        "component": "data-pipeline"
      },
      "properties": {
        "securityRules": [
          {
            "name": "deny-all-inbound",
            "properties": {
              "priority": 100,
              "direction": "Inbound",
              "access": "Deny",
              "protocol": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "*",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*"
            }
          }
        ]
      },
      "condition": "[parameters('deployVm')]"
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-11-01",
      "name": "vnet-la70-data",
      "location": "[resourceGroup().location]",
      "tags": {
        "project": "la70",
        "event": "factored-hackathon-2026",
        "env": "test",
        "component": "data-pipeline"
      },
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.70.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "pipeline",
            "properties": {
              "addressPrefix": "10.70.1.0/24",
              "defaultOutboundAccess": false,
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-la70-data')]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-la70-data')]"
      ],
      "condition": "[parameters('deployVm')]"
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-11-01",
      "name": "pip-la70-data",
      "location": "[resourceGroup().location]",
      "tags": {
        "project": "la70",
        "event": "factored-hackathon-2026",
        "env": "test",
        "component": "data-pipeline"
      },
      "properties": {
        "publicIPAllocationMethod": "Static"
      },
      "sku": {
        "name": "Standard"
      },
      "condition": "[parameters('deployVm')]"
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-11-01",
      "name": "nic-la70-data",
      "location": "[resourceGroup().location]",
      "tags": {
        "project": "la70",
        "event": "factored-hackathon-2026",
        "env": "test",
        "component": "data-pipeline"
      },
      "properties": {
        "ipConfigurations": [
          {
            "name": "primary",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'vnet-la70-data', 'pipeline')]"
              },
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', 'pip-la70-data')]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', 'vnet-la70-data')]",
        "[resourceId('Microsoft.Network/publicIPAddresses', 'pip-la70-data')]"
      ],
      "condition": "[parameters('deployVm')]"
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2023-09-01",
      "name": "vm-la70-data",
      "location": "[resourceGroup().location]",
      "tags": {
        "project": "la70",
        "event": "factored-hackathon-2026",
        "env": "test",
        "component": "data-pipeline"
      },
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "ubuntu-24_04-lts",
            "sku": "server",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "diskSizeGB": 128,
            "managedDisk": {
              "storageAccountType": "StandardSSD_LRS"
            },
            "deleteOption": "Delete"
          }
        },
        "osProfile": {
          "computerName": "la70-data",
          "adminUsername": "la70",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "ssh": {
              "publicKeys": [
                {
                  "path": "/home/la70/.ssh/authorized_keys",
                  "keyData": "[parameters('sshPublicKey')]"
                }
              ]
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', 'nic-la70-data')]"
            }
          ]
        },
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": {
            "secureBootEnabled": true,
            "vTpmEnabled": true
          }
        }
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', 'nic-la70-data')]"
      ],
      "condition": "[parameters('deployVm')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', parameters('storageName')), 'ServicePrincipal', 'blob-contributor')]",
      "scope": "[concat('Microsoft.Storage/storageAccounts/', parameters('storageName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageName'))]",
        "[resourceId('Microsoft.Compute/virtualMachines', 'vm-la70-data')]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
        "principalId": "[reference(resourceId('Microsoft.Compute/virtualMachines', 'vm-la70-data'), '2023-09-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "condition": "[parameters('deployVm')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', parameters('storageName')), 'User', 'blob-contributor')]",
      "scope": "[concat('Microsoft.Storage/storageAccounts/', parameters('storageName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageName'))]",
        "[resourceId('Microsoft.Compute/virtualMachines', 'vm-la70-data')]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
        "principalId": "[parameters('operatorId')]",
        "principalType": "User"
      }
    }
  ],
  "outputs": {
    "storageName": {
      "type": "string",
      "value": "[parameters('storageName')]"
    },
    "vmName": {
      "type": "string",
      "value": "vm-la70-data"
    }
  }
}
