# Stage the production secrets from Azure Key Vault into /run/bank-agent before Docker starts the stack (ADR 0037).
# Installed by deploy/azure/install-vm.sh; it runs the root-owned copy in /usr/local/lib/bank-agent, never the
# checkout. /run is a tmpfs, so every boot fetches the current versions again through the VM's managed identity.
[Unit]
Description=Stage the bank-agent secrets from Azure Key Vault
Wants=network-online.target
After=network-online.target
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/bank-agent/secrets.env
ExecStart=/usr/bin/python3 /usr/local/lib/bank-agent/secrets_stage.py stage --source keyvault --vault ${KEY_VAULT_NAME} --dest /run/bank-agent/secrets
Restart=on-failure
RestartSec=15
RuntimeDirectory=bank-agent
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
