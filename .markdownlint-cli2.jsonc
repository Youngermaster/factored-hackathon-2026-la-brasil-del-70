// markdownlint configuration for every committed Markdown file (run by `make docs-check`).
// Long lines and tables are tolerated: MD013 (line length) and MD060 (table pipe spacing) are off, and so is
// MD032, because the working agreement puts lists directly under bold lead-in lines.
// slides/slides.md is ignored, and only that file: it is Slidev source, not documentation. Every slide
// starts with a `---` frontmatter block, which markdownlint reads as setext headings (MD022, MD003).
// The pitch deck's prose (slides/README.md, slides/script.md, slides/VIDEO.md) stays linted.
// .git/** is ignored because git stores ref logs under branch names, so a branch named like `agent.md`
// creates `.git/logs/refs/remotes/origin/agent.md`, which is not documentation.
{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD032": false,
    "MD033": false,
    "MD041": false,
    "MD060": false
  },
  "globs": ["**/*.md"],
  "gitignore": true,
  "ignores": [".git/**", "kit/**", "**/node_modules/**", ".claude/skills/**", "slides/slides.md"]
}
