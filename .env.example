# Local development settings. `cp .env.example .env` gives a working development environment with no edits;
# `make env` does the same and replaces every dev-only secret with a fresh random value (the stronger option).
# Never commit .env. Never paste real values into prompts or issues. Every setting the code reads is listed here.
# Values that start with dev-only- are development only; production refuses to start with any of them.
# An empty value means the built-in default. Comments on empty values sit on the line above, because an env file
# parser reads text after `NAME=` and spaces as the value.

# --- Runtime -------------------------------------------------------------------------------------------------
APP_ENV=development            # development | test | production
DEMO_MODE=true                 # shows demo one-time codes on screen, labeled; production needs the next line too
ALLOW_PUBLIC_DEMO_MODE=false   # production accepts DEMO_MODE=true only with true (docs/security/demo-mode.md)
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Data platform (bank-data) ---------------------------------------------------------------------------------
BANK_DATA_SOURCE=sample             # sample builds offline from the committed data_platform/sample/; s3 reads the organizer bucket
# Local CSVs instead: `make pipeline DATA_SOURCE=local LOCAL_DIR=data` (the same flags work for seed).
# Empty means data/ (warehouses live in data/warehouse and data/warehouse-sample)
BANK_DATA_DIR=
# Empty means the per-source warehouse directory
BANK_DATA_WAREHOUSE_DIR=
BANK_DATA_DUCKDB_MEMORY_LIMIT=8GB   # DuckDB memory cap; the sample needs far less; 3GB on an 8 GB machine for the full build
BANK_DATA_DUCKDB_THREADS=8          # DuckDB worker threads; 2 on an 8 GB machine for the full build
BANK_DATA_INGEST_WORKERS=6          # parallel downloads and contract checks during ingest
# Organizer bucket: needed only for `make data-download` and BANK_DATA_SOURCE=s3 (or DATA_SOURCE=s3 on make).
# The team gets the values from the organizer data dictionary PDF, which is never committed; leave them empty
# for offline work with the committed sample.
# Organizer credential, s3 source only
AWS_ACCESS_KEY_ID=
# Organizer credential, s3 source only
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2        # the organizer bucket's region
# Organizer bucket name, s3 source only
DATA_BUCKET=
DATA_PREFIX=data/                   # key prefix inside the bucket

# --- PostgreSQL (docker compose publishes it on 127.0.0.1) --------------------------------------------------------
POSTGRES_HOST=localhost             # the compose service from the host; the api container uses its own value
POSTGRES_PORT=5432                  # host port of the compose service
# A second checkout on this machine (a clone or a worktree): docker-compose.yml names its project bank-agent, so
# `make up` there would take over this checkout's container and volume. Export COMPOSE_PROJECT_NAME (for example
# bank-agent-2) and another POSTGRES_PORT in that checkout's shells; the environment wins over this file.
POSTGRES_DB=bank_agent              # database name
POSTGRES_ADMIN_USER=bank_owner      # owner role: migrations and the seed
POSTGRES_ADMIN_PASSWORD=dev-only-not-a-secret-postgres-owner-password   # development only; production refuses it
POSTGRES_APP_USER=bank_app          # application role: no table ownership, no BYPASSRLS
POSTGRES_APP_PASSWORD=dev-only-not-a-secret-postgres-app-password       # development only; production refuses it

# --- Security (docs/api/README.md, docs/security/identity-and-sessions.md) ----------------------------------------
SESSION_SECRET=dev-only-not-a-secret-session-key-for-local-work-0000   # identity and code keys; development only; production refuses it
CSRF_SECRET=dev-only-not-a-secret-csrf-key-for-local-work-000000000    # signs CSRF tokens; development only; production refuses it
CORS_ALLOWED_ORIGINS=http://localhost:5173   # the Vite dev server; comma separated; production refuses * and plain http
MAX_REQUEST_BODY_BYTES=16384                 # larger request bodies get 413
# Requests per minute per rate class, per client IP and per session; over the limit is 429 with Retry-After
RATE_LIMIT_AUTH_PER_MINUTE=10                # login, step-up, logout, CSRF token, per IP
RATE_LIMIT_WRITE_PER_MINUTE=30               # conversation turns and inbox moves, per IP
RATE_LIMIT_READ_PER_MINUTE=120               # reads, per IP
RATE_LIMIT_SESSION_AUTH_PER_MINUTE=10        # the same classes, per session
RATE_LIMIT_SESSION_WRITE_PER_MINUTE=20
RATE_LIMIT_SESSION_READ_PER_MINUTE=60
RATE_LIMIT_BACKEND=memory                    # memory: one process | postgres: shared by every worker (production)

# --- Language model gateway (docs/architecture/llm-gateway.md) ---------------------------------------------------
# fake: no model (workflows use their deterministic fallbacks; needs nothing). cassette: replay recorded replies.
# litellm: a live provider through the optional litellm extra (`uv sync --all-packages --extra litellm`).
LLM_PROVIDER=fake                   # fake | cassette | litellm
# Provider/model id, required for cassette and litellm
LLM_PRIMARY_MODEL=
# Optional second model tried after the primary fails
LLM_FALLBACK_MODEL=
# Required for hosted litellm models; never for local Ollama models
LLM_API_KEY_PRIMARY=
# Required with a hosted fallback model
LLM_API_KEY_FALLBACK=
# Optional provider base URL passed to LiteLLM; https only in production
LLM_API_BASE=
LLM_ALLOW_PRIVATE_HTTP_BASE=false   # production: true accepts http only for a private host (the ollama profile)
# Opt-in local model (development only, never a default, never production). With Ollama serving
# qwen2.5:7b-instruct on this machine, set these three lines instead of the defaults above:
#   LLM_PROVIDER=litellm
#   LLM_PRIMARY_MODEL=ollama/qwen2.5:7b-instruct
#   LLM_API_BASE=http://localhost:11434
# Ollama models need no key and cost nothing (services/api/config/llm_prices.yaml). `make llm-smoke` runs the
# fixture prompts against the configured provider; `make api-local-llm` runs the API with the local model.
LLM_DAILY_BUDGET_USD=5              # daily spend cap
LLM_SESSION_TOKEN_LIMIT=20000       # tokens per session lineage
LLM_CONVERSATION_BUDGET_USD=0.50    # spend cap per conversation
LLM_TIMEOUT_SECONDS=20              # per call
LLM_MAX_RETRIES=2                   # 0 to 2; transient errors only
LLM_RETRY_BASE_DELAY_SECONDS=0.5    # exponential backoff base, with jitter
LLM_RETRY_MAX_DELAY_SECONDS=4       # backoff ceiling
LLM_CIRCUIT_FAILURE_THRESHOLD=5     # failures before the circuit opens
LLM_CIRCUIT_RESET_SECONDS=30        # open time before a trial call
LLM_CIRCUIT_HALF_OPEN_MAX_CALLS=1   # trial calls while half open
# Empty means services/api/config/llm_prices.yaml
LLM_PRICES_FILE=
LLM_CASSETTE_MODE=replay            # replay | record (record calls a live provider; never in production)
# Empty means evals/cassettes
LLM_CASSETTE_DIR=
LLM_TRACE_CONTENT=false             # true adds redacted prompt variables and outputs to spans; never in production
LLM_BUDGET_LEDGER=auto              # auto: shared in PostgreSQL when the database is configured; memory: per process

# --- Workflow engine and models (docs/workflows/workflow-router.md) ----------------------------------------------
WORKFLOW_ENABLED=account_inquiry,card_support,dispute,credit   # the router dispatches only to these
WORKFLOW_LLM_UNDERSTANDING=true     # slot extraction and signals through the gateway; fake falls back deterministically
WORKFLOW_LLM_PHRASING=false         # model phrasing of replies; always checked by the grounding verifier
WORKFLOW_LLM_HANDOFF_SUMMARY=false  # model summary in handoffs; must cite only supplied facts
WORKFLOW_MAX_TURNS=40               # turns per conversation before a handoff
WORKFLOW_TOOL_TIMEOUT_SECONDS=5     # bound on one tool attempt; a slow tool is a tool timeout (retried, then handed off)
WORKFLOW_ROUTER=keyword@1           # or tfidf@champion / embeddings@champion after make train and make promote
WORKFLOW_RESOLVER=rules@1           # or lgbm@champion; without an artifact the rule baseline serves
WORKFLOW_RISK_ESTIMATOR=score_band@1   # or logreg@champion or lgbm@champion; without an artifact the baseline serves
WORKFLOW_MAX_ELIGIBILITY_ASSESSMENTS=5   # synthetic assessments per customer in the window; past it a person reviews
WORKFLOW_ELIGIBILITY_ASSESSMENT_WINDOW_MINUTES=60   # the absolute session lifetime, so a new sign-in does not reset it
# Empty means data/artifacts/models (gitignored)
WORKFLOW_MODEL_REGISTRY_DIR=
WORKFLOW_LANGUAGE_DETECTOR=lexical@1   # the only detector today
MLFLOW_TRACKING_URI=file:./mlruns   # experiment tracking for evaluations (local file store, gitignored)

# --- Policy pack and retrieval (docs/evaluation/retrieval.md) ----------------------------------------------------
# Empty means policies/
POLICY_DIR=
POLICY_DATA_AS_OF=2026-06-17        # the organizer snapshot date; policy windows count to it, not to the wall clock
RETRIEVAL_RETRIEVER=bm25            # bm25 | dense | hybrid; dense and hybrid need the optional ml extra
RETRIEVAL_INDEX_SOURCE=build        # build (from the loaded pack at startup) | stored (required in production)
# Empty means data/artifacts/retrieval/indexes
RETRIEVAL_INDEX_DIR=
# Empty means intfloat/multilingual-e5-small
RETRIEVAL_EMBEDDING_MODEL=
# Empty means data/models/huggingface
RETRIEVAL_MODEL_CACHE_DIR=
# Empty means data/artifacts/retrieval/embeddings
RETRIEVAL_EMBEDDING_CACHE_DIR=
RETRIEVAL_RRF_K=60                  # reciprocal rank fusion constant for hybrid
# Empty means the threshold tuned on the development split
RETRIEVAL_THRESHOLD_BM25=
# Empty means the tuned dense threshold
RETRIEVAL_THRESHOLD_DENSE=
RETRIEVAL_ANSWER_K=3                # clauses cited in an informational answer

# --- Evaluation summaries (GET /v1/eval/summaries) ----------------------------------------------------------------
# Empty means evals/reports/summaries (written by the evaluation harness)
EVAL_SUMMARIES_DIR=
EVAL_SUMMARIES_PUBLIC=false         # true serves them without a session (read only)

# --- Degradation ladder (docs/operations/degradation.md) ----------------------------------------------------
DEGRADATION_FALLBACK_PROVIDER=true  # L1: use LLM_FALLBACK_MODEL while the primary circuit is open
DEGRADATION_TEMPLATE_ONLY=true      # L2: skip model calls while no provider can serve or the daily budget is spent
DEGRADATION_MODEL_BASELINES=true    # L3: serve the baselines when a learned model cannot load (false stops startup)
DEGRADATION_ROUTER_THRESHOLD=0.75   # L3: the stricter keyword router threshold used then
DEGRADATION_RISK_BAND_FALLBACK=false   # L3: true serves score_band@1 for a learned estimator that cannot load
DEGRADATION_CREDIT_CATALOG_FALLBACK=true   # a catalog that cannot load disables credit (false stops startup)
DEGRADATION_DATABASE_RETRY_AFTER_SECONDS=30   # L4: Retry-After on the 503 while the database is unavailable

# --- Retention (bank-agent retention purge; docs/security/data-retention.md) -----------------------------------
RETENTION_CONVERSATION_DAYS=7       # conversation text, after the last activity
RETENTION_SESSION_DAYS=7            # sessions, one-time-code challenges, trust events, after they end
RETENTION_CREDIT_APPLICATION_DAYS=30   # withdrawn or closed credit intakes, after the last status change

# --- Observability --------------------------------------------------------------------------------------------
OTEL_ENABLED=false                  # true exports spans and metrics (needs the collector: make up PROFILES=obs)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # OTLP over HTTP to the collector of the obs compose profile
OTEL_SERVICE_NAME=bank-agent-api    # service name on spans and metrics
OTEL_TRACES_SAMPLER_ARG=1.0         # parent-based trace-id ratio: 1.0 keeps every trace, 0.1 keeps one in ten
OTEL_METRIC_EXPORT_INTERVAL=15000   # milliseconds between metric exports

# --- Langfuse generation tracing (docs/operations/observability.md) -------------------------------------------
# Optional second OTLP/HTTP exporter for metadata-only gen_ai.chat spans. No LiteLLM callback is registered.
# Keep OTEL_EXPORTER_OTLP_ENDPOINT pointed at the collector, not at Langfuse, to avoid duplicate observations.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:3000   # https required in production
# Required only when Langfuse is enabled.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
