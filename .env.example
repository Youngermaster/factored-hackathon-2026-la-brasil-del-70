# Copy to .env and fill in locally. Never commit .env. Never paste real values into prompts or issues.
# Phases extend this file as they add settings; every variable must be documented here.

# Runtime
APP_ENV=development            # development | test | production
DEMO_MODE=true                 # shows demo one-time codes on screen; must be false in production
LOG_LEVEL=INFO

# Organizer dataset (values come from the organizer data dictionary PDF; keep them out of git)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
DATA_BUCKET=
DATA_PREFIX=data/

# Data platform (bank-data). The source is explicit and never mixed: sample builds from the committed
# data_platform/sample/ with no network; s3 reads the organizer bucket (needs the values above).
# For local CSVs, use `make pipeline DATA_SOURCE=local LOCAL_DIR=data` (and the same flags for seed).
BANK_DATA_SOURCE=sample             # sample | s3; use DATA_SOURCE=local plus LOCAL_DIR for local CSVs
# Default: data/ (separate warehouse, warehouse-sample, warehouse-local).
BANK_DATA_DIR=
# Overrides the per-source warehouse directory.
BANK_DATA_WAREHOUSE_DIR=
BANK_DATA_DUCKDB_MEMORY_LIMIT=8GB
BANK_DATA_DUCKDB_THREADS=8
BANK_DATA_INGEST_WORKERS=6

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bank_agent
POSTGRES_ADMIN_USER=bank_owner
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_USER=bank_app
POSTGRES_APP_PASSWORD=

# Security
# 64+ random bytes, base64; production refuses to start if empty.
SESSION_SECRET=
CSRF_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Policy pack (synthetic). Time windows count to the data's as-of date, never to the wall clock.
# Default: policies/.
POLICY_DIR=
POLICY_DATA_AS_OF=2026-06-17   # the organizer snapshot date; the end of the seeded data

# Open retrieval for informational questions (docs/evaluation/retrieval.md justifies the defaults)
RETRIEVAL_RETRIEVER=bm25       # bm25 | dense | hybrid; dense and hybrid need the optional ml extra
RETRIEVAL_INDEX_SOURCE=build   # build (from the loaded pack) | stored (required in production)
# Default: data/artifacts/retrieval/indexes.
RETRIEVAL_INDEX_DIR=
# Default: intfloat/multilingual-e5-small.
RETRIEVAL_EMBEDDING_MODEL=
# Default: data/models/huggingface.
RETRIEVAL_MODEL_CACHE_DIR=
# Default: data/artifacts/retrieval/embeddings.
RETRIEVAL_EMBEDDING_CACHE_DIR=
RETRIEVAL_RRF_K=60
# Default: tuned on the development split of the judgments.
RETRIEVAL_THRESHOLD_BM25=
RETRIEVAL_THRESHOLD_DENSE=
RETRIEVAL_ANSWER_K=3

# Workflow engine (docs/workflows/workflow-router.md)
WORKFLOW_ENABLED=account_inquiry,card_support,dispute,credit   # the router dispatches only to these; others are out of scope
WORKFLOW_LLM_UNDERSTANDING=true         # slot extraction and signals through the gateway, with deterministic fallbacks
WORKFLOW_LLM_PHRASING=false             # model phrasing of replies; always checked by the grounding verifier
WORKFLOW_LLM_HANDOFF_SUMMARY=false      # model summary in handoffs; must cite only supplied facts
WORKFLOW_MAX_TURNS=40
WORKFLOW_ROUTER=keyword@1              # or tfidf@champion / embeddings@champion (learned; make train, then make promote)
WORKFLOW_RESOLVER=rules@1               # or lgbm@champion; without an artifact the rule baseline serves
# Empty means data/artifacts/models (gitignored).
WORKFLOW_MODEL_REGISTRY_DIR=
WORKFLOW_LANGUAGE_DETECTOR=lexical@1
WORKFLOW_RISK_ESTIMATOR=score_band@1    # the credit risk baseline until session 10b registers the learned estimator

# Experiment tracking for evaluations (local file store, gitignored)
MLFLOW_TRACKING_URI=file:./mlruns

# LLM gateway (provider and model are chosen by evaluation, not by habit)
LLM_PROVIDER=fake              # fake | cassette | litellm
LLM_PRIMARY_MODEL=
LLM_FALLBACK_MODEL=
LLM_API_KEY_PRIMARY=
LLM_API_KEY_FALLBACK=
LLM_DAILY_BUDGET_USD=5
LLM_SESSION_TOKEN_LIMIT=20000
LLM_CONVERSATION_BUDGET_USD=0.50
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2               # 0 to 2; transient errors only
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=4
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RESET_SECONDS=30
LLM_CIRCUIT_HALF_OPEN_MAX_CALLS=1
# Default: services/api/config/llm_prices.yaml.
LLM_PRICES_FILE=
LLM_CASSETTE_MODE=replay        # replay | record (record calls a live provider; never in production)
# Default: evals/cassettes.
LLM_CASSETTE_DIR=
LLM_TRACE_CONTENT=false         # true adds redacted prompt variables and outputs to spans; never in production

# Models and registry
MODEL_REGISTRY_BACKEND=filesystem   # filesystem | mlflow
ROUTER_MODEL=champion
RESOLVER_MODEL=champion
MLFLOW_TRACKING_URI=file:./mlruns

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=bank-agent-api
