# Development image for the compose `api` profile: hot reload over a read-only bind mount of the repository.
# Production images are multi-stage and built in phase 16.
FROM ghcr.io/astral-sh/uv:0.11.17-python3.12-trixie-slim

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_CACHE_DIR=/opt/uv-cache \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Non-root user. The virtual environment and cache directories are created here, owned by that user, so the
# named volumes mounted over them inherit the ownership.
RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /home/app --create-home app \
    && mkdir -p /opt/venv /opt/uv-cache /workspace \
    && chown app:app /opt/venv /opt/uv-cache

USER app
WORKDIR /workspace

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=60s --retries=5 \
    CMD ["python", "-c", "import urllib.request, sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=2).status == 200 else 1)"]

CMD ["uv", "run", "--frozen", "--no-dev", "--package", "bank-agent", \
     "uvicorn", "bank_agent.asgi:create_app", "--factory", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--reload", "--reload-dir", "/workspace/services/api/src"]
